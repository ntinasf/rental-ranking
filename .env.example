# Copy to .env and fill in. Never commit .env (gitignored).

# Azure ML workspace
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=

# Azure AI Language (opinion mining / sentiment)
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# Managed online endpoint — set only while it is deployed, and delete with it.
# The key dies with the endpoint; there is nothing to rotate after teardown.
#   az ml online-endpoint show --name rental-ranker --query scoring_uri -o tsv
#   az ml online-endpoint get-credentials --name rental-ranker --query primaryKey -o tsv
AML_ENDPOINT_URI=
AML_ENDPOINT_KEY=

# Anonymization salt for ID hashing (any long random string; keep it stable —
# changing it changes every hashed ID)
ANON_SALT=
